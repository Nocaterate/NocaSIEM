# HTTP API port (used by the dashboard frontend)
PORT=4000

# UDP port that receives incoming syslog-style log messages from your
# configured sources (firewalls, servers, apps, etc.)
INGEST_PORT=5514

# TCP port for sources configured with protocol=TCP (newline-delimited log lines)
INGEST_TCP_PORT=5515

# Secret used to sign JWT auth tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=*
