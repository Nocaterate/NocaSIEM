# Copy this file to .env for local development. On a hosting provider, set
# these as environment variables in its dashboard instead.

# HTTP port for the website + API (most hosts set PORT for you)
PORT=4000

# UDP port that receives incoming syslog-style log messages from your
# configured sources (firewalls, servers, apps, etc.)
INGEST_PORT=5514

# TCP port for sources configured with protocol=TCP (newline-delimited log lines)
INGEST_TCP_PORT=5515

# Secret used to sign login tokens. REQUIRED, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Set to false after you've created your own (admin) account, so strangers
# can't sign up on your public instance.
ALLOW_REGISTRATION=true

# On a fresh deployment the first account becomes admin. Set this to your
# email BEFORE deploying so nobody else can claim that first admin account.
# ADMIN_EMAIL=you@example.com

# By default, log lines are only accepted from IPs registered as a source.
# Set to true to also store traffic from unknown IPs (visible to admins only).
# INGEST_ALLOW_UNREGISTERED=false

# Max log lines accepted per second from a single source IP.
# INGEST_RATE_LIMIT=100

# Interface for the web server. Defaults to 127.0.0.1 for `npm run dev`
# (dev server stays private to this machine) and all interfaces for `npm start`.
# HOST=0.0.0.0

# Where accounts, sources, logs and alerts are stored. Point this at a
# persistent disk/volume in production (e.g. /data/nocasiem.json).
# DATA_FILE=./data.json   (default: data.json in the project folder)

# Set when running behind a reverse proxy or PaaS (Nginx, Caddy, Render,
# Railway...) so the login lockout sees real client IPs. Usually "1".
# TRUST_PROXY=1

# Only needed if the dashboard is hosted on a DIFFERENT domain than this
# server. Comma-separated list of allowed origins. Leave unset otherwise.
# CORS_ORIGIN=https://dashboard.example.com
